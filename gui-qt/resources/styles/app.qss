/* Token placeholders mirror gui/src/theme — replaced at runtime by StylesheetBuilder */

QWidget#AvarRoot {
    background-color: @@BG@@;
    color: @@TEXT@@;
    font-family: "@@FONT@@", system-ui, sans-serif;
}

/* Default readable text (plain QLabel / form labels without a themed class) */
QLabel {
    color: @@TEXT@@;
    background-color: transparent;
}

QDialog {
    background-color: @@BG_ELEVATED@@;
    color: @@TEXT@@;
}

QMenu {
    background-color: @@BG_ELEVATED@@;
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: @@RADIUS_INNER@@px;
}

QMenu::item:selected {
    background-color: @@PRIMARY@@;
    color: @@PRIMARY_TEXT@@;
}

QMenu::separator {
    height: 1px;
    background: @@BORDER@@;
    margin: 4px 8px;
}

QLabel[class="AvarSectionTitle"] {
    font-weight: 700;
    font-size: 14px;
    margin-top: 8px;
    color: @@TEXT@@;
}

QLabel[class="AvarPageTitle"] {
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 6px;
    color: @@TEXT@@;
    max-height: 2em;
}

QLabel[class="AvarPopupTitle"] {
    font-weight: 700;
    font-size: 16px;
    color: @@TEXT@@;
}

QLabel[class="AvarSidebarNavTitle"] {
    font-weight: 600;
    font-size: 13px;
    color: @@TEXT_MUTED@@;
    padding: 4px 10px 6px 10px;
}

QLabel[class="AvarDownloadPanelTitle"] {
    font-weight: 700;
    font-size: 15px;
    color: @@TEXT@@;
    padding: 8px 12px;
}

QWidget#AvarExtensionPanel {
    position: relative;
}

QWidget[class="AvarExtensionTrigger"] {
    background: transparent;
}

QWidget#AvarHeaderActions QPushButton[class="AvarButtonGhost"] {
    padding: 4px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    font-size: 14px;
}

QWidget[class="AvarExtensionTrigger"] QPushButton[class="AvarButtonGhost"] {
    color: @@TEXT_MUTED@@;
}

QWidget[class="AvarExtensionTrigger"] QPushButton[class="AvarButtonGhost"]:hover:enabled {
    color: @@TEXT@@;
}

QLabel[class="AvarExtensionDot"] {
    background-color: @@TEXT_MUTED@@;
    border: 1px solid @@BG_ELEVATED@@;
    border-radius: 4px;
    min-width: 7px;
    max-width: 7px;
    min-height: 7px;
    max-height: 7px;
    margin-top: 1px;
    margin-right: 1px;
}

QLabel[class="AvarExtensionDot"][state="ok"] {
    background-color: @@SUCCESS@@;
}

QLabel[class="AvarExtensionDot"][state="error"] {
    background-color: @@DANGER@@;
}

QFrame#AvarExtensionMenu {
    background-color: @@BG_ELEVATED@@;
    border: 1px solid @@BORDER_SUBTLE@@;
    border-radius: @@RADIUS@@px;
}

QLabel[class="AvarExtensionHeading"] {
    font-size: 14px;
    font-weight: 600;
    color: @@TEXT@@;
    margin-bottom: 8px;
}

QLabel[class="AvarExtensionStatusText"] {
    font-size: 13px;
    color: @@TEXT@@;
    margin-bottom: 10px;
}

QCheckBox[class="AvarExtensionListen"] {
    font-size: 13px;
    margin-bottom: 8px;
}

QLabel[class="AvarExtensionSuspendHint"] {
    font-size: 12px;
    color: @@TEXT_MUTED@@;
    margin-bottom: 10px;
}

QLabel[class="AvarExtensionFieldLabel"] {
    font-size: 12px;
    color: @@TEXT_MUTED@@;
    margin-top: 4px;
}

QLabel[class="AvarExtensionCode"] {
    font-size: 12px;
    color: @@TEXT@@;
    margin-bottom: 6px;
}

QLabel[class="AvarExtensionMetaKey"] {
    font-size: 12px;
    font-weight: 600;
    color: @@TEXT_MUTED@@;
}

QLabel[class="AvarExtensionMetaValue"] {
    font-size: 12px;
    color: @@TEXT@@;
    margin-bottom: 4px;
}

QLabel[class="AvarExtensionUpdate"] {
    font-size: 12px;
    color: @@WARNING@@;
    margin-top: 10px;
}

QMainWindow#AvarMainWindow,
QMainWindow#AvarSecondaryWindow {
    background: transparent;
}

QMainWindow#AvarMainWindow[maximized="true"],
QMainWindow#AvarSecondaryWindow[maximized="true"] {
    background: @@BG@@;
}

/* Outer: transparent inset for shadow gap (see kWindowedOuterMargin); no border here */
QWidget#AvarDesktopOuter {
    background: transparent;
    border: none;
}

QWidget#AvarDesktopFrame {
    background-color: @@BG@@;
    border: 1px solid @@BORDER_CHROME@@;
    border-radius: @@RADIUS@@px;
}

QWidget#AvarDesktopFrame[maximized="true"] {
    border-radius: 0;
    border: none;
}

/* Popup / secondary windows (AvarWindow) — stronger edge so they read above the main shell */
QWidget#AvarDesktopFrame[secondary="true"] {
    border: 1px solid @@BORDER@@;
}

QWidget#AvarDesktopFrame[secondary="true"][maximized="true"] {
    border-radius: 0;
    border: none;
}

QWidget#AvarRoot[maximized="true"] QWidget#AvarSidebar {
    border-bottom-left-radius: 0;
}

/* Header (.avar-header) */
QWidget#AvarHeader {
    background-color: @@BG_ELEVATED@@;
    border-bottom: 1px solid @@BORDER@@;
    min-height: 44px;
    border-top-left-radius: @@RADIUS@@px;
    border-top-right-radius: @@RADIUS@@px;
}

QWidget#AvarHeader[desktop="true"] {
    border-top-left-radius: @@RADIUS@@px;
    border-top-right-radius: @@RADIUS@@px;
}

QWidget#AvarHeader[maximized="true"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QWidget#AvarHeader[secondary="true"] {
    border-top-left-radius: @@RADIUS@@px;
    border-top-right-radius: @@RADIUS@@px;
}

QWidget#AvarHeader[secondary="true"][maximized="true"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QWidget#AvarWindowControls {
    background: transparent;
}

QPushButton[class="AvarWindowControlBtn"] {
    border: none;
    border-radius: 0;
    background: transparent;
    color: @@TEXT_MUTED@@;
    font-size: 14px;
    padding: 0;
}

QPushButton[class="AvarWindowControlBtn"]:hover {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
}

QPushButton[class="AvarWindowControlBtnClose"]:hover {
    background-color: #e81123;
    color: #ffffff;
}

QPushButton[glyph="close"] {
    font-size: 18px;
}

QLabel#AvarHeaderTitle {
    font-size: 15px;
    font-weight: 700;
    color: @@TEXT@@;
}

QLabel#AvarHeaderSubtitle {
    font-size: 12px;
    font-weight: 400;
    color: @@TEXT_MUTED@@;
    margin-left: 8px;
}

QLabel#AvarHeaderIcon {
    margin-right: 8px;
}

QFrame#AvarHeaderSeparator {
    color: @@BORDER@@;
    max-width: 1px;
    margin: 4px 8px;
}

QPushButton#AvarHeaderHelp[active="true"],
QPushButton#AvarHeaderSettings[active="true"] {
    background-color: @@BG_MUTED@@;
    color: @@PRIMARY@@;
}

QPushButton#AvarHeaderTheme::menu-indicator {
    image: none;
    width: 0;
    height: 0;
    border: none;
    margin: 0;
    padding: 0;
}

/* Shell sidebar (.avar-shell__sidebar) */
QWidget#AvarSidebar {
    background-color: @@BG_ELEVATED@@;
    border-right: 1px solid @@BORDER@@;
    border-bottom-left-radius: @@RADIUS@@px;
}

/* Sidebar nav (.avar-sidebar-nav__item) */
QPushButton[class="AvarSidebarNavItem"] {
    text-align: left;
    padding: 8px 10px;
    border: none;
    border-radius: @@RADIUS@@px;
    background: transparent;
    color: @@TEXT@@;
    font-size: 14px;
}

QPushButton[class="AvarSidebarNavItem"]:hover {
    background-color: @@BG_MUTED@@;
}

QPushButton[class="AvarSidebarNavItem"][active="true"] {
    background-color: @@BG_MUTED@@;
    color: @@PRIMARY@@;
    font-weight: 600;
}

QPushButton[class="AvarSidebarNavItem"][stripedIndex="0"],
QPushButton[class="AvarSidebarNavItem"][stripedIndex="2"],
QPushButton[class="AvarSidebarNavItem"][stripedIndex="4"],
QPushButton[class="AvarSidebarNavItem"][stripedIndex="6"],
QPushButton[class="AvarSidebarNavItem"][stripedIndex="8"] {
    background-color: @@BG@@;
}

QWidget#AvarHelpPage {
    background-color: @@BG@@;
}

QTextBrowser#AvarHelpMarkdown {
    background: transparent;
    color: @@TEXT@@;
    border: none;
    font-size: 15px;
    line-height: 1.6;
    max-width: 832px;
}

QTextBrowser#AvarHelpMarkdown a {
    color: @@PRIMARY@@;
}

/* Buttons (.avar-btn) */
QPushButton[class="AvarButtonPrimary"] {
    background-color: @@PRIMARY@@;
    color: @@PRIMARY_TEXT@@;
    border: 1px solid transparent;
    border-radius: @@RADIUS@@px;
    padding: 8px 14px;
}

QPushButton.AvarButtonPrimary:hover:enabled {
    background-color: @@PRIMARY_HOVER@@;
}

QPushButton[class="AvarButtonSecondary"] {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS@@px;
    padding: 8px 14px;
}

QPushButton[class="AvarButtonDanger"] {
    background-color: @@DANGER@@;
    color: #ffffff;
    border: none;
    border-radius: @@RADIUS@@px;
    padding: 6px 12px;
}

QPushButton.AvarButtonDanger:hover:enabled {
    background-color: @@DANGER@@;
    opacity: 0.9;
}

QPushButton[class="AvarButtonGhost"] {
    background: transparent;
    color: @@TEXT_MUTED@@;
    border: none;
    border-radius: @@RADIUS@@px;
    padding: 6px 10px;
}

QPushButton.AvarButtonGhost:hover:enabled {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
}

/* Form controls (.avar-input / .avar-select) */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: @@BG_ELEVATED@@;
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS_INNER@@px;
    padding: 6px 10px;
    min-height: 1.2em;
    selection-background-color: @@PRIMARY@@;
    selection-color: @@PRIMARY_TEXT@@;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: @@PRIMARY@@;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    color: @@TEXT_MUTED@@;
    background-color: @@BG_MUTED@@;
    border-color: @@BORDER@@;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    border-left: 1px solid @@BORDER@@;
    background-color: @@BG_MUTED@@;
    border-top-right-radius: @@RADIUS_INNER@@px;
    border-bottom-right-radius: @@RADIUS_INNER@@px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(@@DROPDOWN_CHEVRON@@);
    border: none;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: @@BG_ELEVATED@@;
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS_INNER@@px;
    padding: 4px;
    outline: none;
    selection-background-color: @@PRIMARY@@;
    selection-color: @@PRIMARY_TEXT@@;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: @@BG_MUTED@@;
    border: none;
    border-left: 1px solid @@BORDER@@;
    width: 18px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: @@BORDER@@;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid @@TEXT_MUTED@@;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @@TEXT_MUTED@@;
}

QCheckBox {
    color: @@TEXT@@;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @@BORDER@@;
    border-radius: 4px;
    background-color: @@BG_ELEVATED@@;
}

QCheckBox::indicator:hover {
    border-color: @@PRIMARY@@;
}

QCheckBox::indicator:checked {
    background-color: @@PRIMARY@@;
    border-color: @@PRIMARY@@;
}

QCheckBox::indicator:disabled {
    background-color: @@BG_MUTED@@;
    border-color: @@BORDER@@;
}

QGroupBox {
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS@@px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: @@TEXT@@;
}

QLabel[class="AvarSettingsHint"] {
    color: @@TEXT_MUTED@@;
    font-size: 12px;
}

QWidget#AvarSettingsForm {
    max-width: 420px;
}

QWidget#AvarSettingsForm[wide="true"] {
    max-width: 640px;
}

QWidget#AvarSettingsForm QLineEdit,
QWidget#AvarSettingsForm QComboBox,
QWidget#AvarSettingsForm QSpinBox,
QWidget#AvarSettingsForm QDoubleSpinBox,
QWidget#AvarSettingsForm QTextEdit,
QWidget#AvarSettingsForm QPlainTextEdit {
    max-width: 420px;
}

QWidget#AvarSettingsForm[wide="true"] QLineEdit,
QWidget#AvarSettingsForm[wide="true"] QComboBox,
QWidget#AvarSettingsForm[wide="true"] QSpinBox,
QWidget#AvarSettingsForm[wide="true"] QDoubleSpinBox,
QWidget#AvarSettingsForm[wide="true"] QTextEdit,
QWidget#AvarSettingsForm[wide="true"] QPlainTextEdit {
    max-width: 640px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QListWidget {
    background-color: @@BG_ELEVATED@@;
    color: @@TEXT@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS@@px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: @@PRIMARY@@;
    color: @@PRIMARY_TEXT@@;
}

QListWidget::item:hover:!selected {
    background-color: @@BG_MUTED@@;
}

/* Download card grid — clip viewport in code; per-item cards like gui download-list--cards */
QListWidget#AvarDownloadGrid {
    padding: 6px;
    border-color: @@BORDER_SUBTLE@@;
}

QListWidget#AvarDownloadGrid::item {
    background-color: @@BG@@;
    border: 1px solid @@BORDER_SUBTLE@@;
    border-radius: @@RADIUS_INNER@@px;
    padding: 8px;
    color: @@TEXT@@;
}

QListWidget#AvarDownloadGrid::item:selected {
    background-color: @@BG_MUTED@@;
    border-color: @@PRIMARY@@;
    color: @@TEXT@@;
}

QListWidget#AvarDownloadGrid::item:hover:!selected {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
}

/* Table */
QTableView,
QTableWidget {
    background-color: @@BG_ELEVATED@@;
    alternate-background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
    gridline-color: @@BORDER@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS@@px;
    selection-background-color: @@PRIMARY@@;
    selection-color: @@PRIMARY_TEXT@@;
}

QHeaderView::section {
    background-color: @@BG_MUTED@@;
    color: @@TEXT_MUTED@@;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid @@BORDER@@;
    font-weight: 600;
}

QScrollBar:vertical {
    background: @@BG_MUTED@@;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @@BORDER@@;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: @@TEXT_MUTED@@;
}

QLabel#ConnectionBadge[connected="true"] {
    color: @@SUCCESS@@;
}

QLabel#ConnectionBadge[connected="false"] {
    color: @@DANGER@@;
}

QWidget#AvarFooter {
    background-color: @@BG_ELEVATED@@;
    border-top: 1px solid @@BORDER_SUBTLE@@;
    min-height: 28px;
    max-height: 28px;
}

QLabel[class="AvarFooterStat"] {
    color: @@TEXT_MUTED@@;
    font-size: 11px;
    padding: 0;
    margin: 0;
}

QPushButton[class="AvarFooterConsoleBtn"] {
    background: transparent;
    color: @@TEXT_MUTED@@;
    border: 1px solid transparent;
    border-radius: @@RADIUS@@px;
    padding: 2px 8px;
    font-size: 11px;
    min-height: 0;
    max-height: 24px;
}

QPushButton[class="AvarFooterConsoleBtn"]:hover:enabled {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
}

QPushButton[class="AvarFooterConsoleBtn"][footerConsoleOpen="true"] {
    background-color: @@BG_MUTED@@;
    color: @@TEXT@@;
    border-color: @@BORDER@@;
}

QPushButton[class="AvarFooterConsoleBtn"][footerConsoleAlert="true"] {
    background-color: @@DANGER@@;
    color: #ffffff;
    border: none;
}

QPushButton[class="AvarFooterConsoleBtn"][footerConsoleAlert="true"]:hover:enabled {
    opacity: 0.9;
}

QWidget#AvarConsole {
    background-color: @@BG_ELEVATED@@;
    border-top: 1px solid @@BORDER@@;
}

QWidget[class="AvarConsoleHeader"] {
    border-bottom: 1px solid @@BORDER@@;
    padding: 4px 8px;
}

QLabel[class="AvarConsoleTitle"] {
    font-weight: 600;
    font-size: 13px;
    color: @@TEXT@@;
}

QLabel[class="AvarConsoleSeverityLabel"] {
    color: @@TEXT_MUTED@@;
    font-size: 11px;
}

QScrollArea#AvarConsoleOutput {
    background-color: @@BG_MUTED@@;
    border: none;
}

QLabel[class="AvarConsoleEmpty"] {
    color: @@TEXT_MUTED@@;
    padding: 24px;
    font-size: 12px;
}

QLabel[class="AvarConsoleLine"] {
    font-family: monospace;
    font-size: 12px;
    color: @@TEXT@@;
    padding: 1px 0;
}

QLabel[class="AvarConsoleLine"][lineLevel="AvarConsoleLineError"] {
    color: @@DANGER@@;
}

QLabel[class="AvarConsoleLine"][lineLevel="AvarConsoleLineWarn"] {
    color: @@WARNING@@;
}

QLabel[class="AvarConsoleLine"][lineLevel="AvarConsoleLineDebug"] {
    color: @@TEXT_MUTED@@;
}

QWidget#AvarSessionSelector {
    border-top: 1px solid @@BORDER@@;
}

QWidget[class="AvarSessionTrigger"] {
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS_INNER@@px;
    background: @@BG@@;
}

QWidget[class="AvarSessionTrigger"]:hover {
    border-color: @@PRIMARY@@;
}

QLabel[class="AvarConnectionDot"] {
    background-color: @@DANGER@@;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

QLabel[class="AvarConnectionDot"][connected="true"] {
    background-color: @@SUCCESS@@;
}

QLabel[class="AvarSessionLabel"] {
    font-weight: 600;
    font-size: 14px;
    color: @@TEXT@@;
}

QLabel[class="AvarSessionStatus"] {
    color: @@TEXT_MUTED@@;
    font-size: 12px;
}

QLabel[class="AvarSessionChevron"] {
    color: @@TEXT_MUTED@@;
    font-size: 13px;
    min-width: 16px;
    padding: 0 2px;
}

QPushButton[class="AvarSessionRefresh"] {
    border: none;
    border-radius: 4px;
    background: transparent;
    color: @@TEXT_MUTED@@;
    font-size: 14px;
    padding: 0;
}

QPushButton[class="AvarSessionRefresh"]:hover:enabled {
    color: @@PRIMARY@@;
    background-color: @@BG_MUTED@@;
}

QPushButton[class="AvarSessionRefresh"]:disabled {
    color: @@TEXT_MUTED@@;
    opacity: 0.55;
}

QFrame[class="AvarSessionMenu"] {
    background-color: @@BG_ELEVATED@@;
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS@@px;
}

QWidget[class="AvarSessionListItem"] {
    border: 1px solid @@BORDER@@;
    border-radius: @@RADIUS_INNER@@px;
    background: @@BG@@;
    color: @@TEXT@@;
    min-height: 52px;
}

QWidget[class="AvarSessionListItem"]:hover {
    border-color: @@PRIMARY@@;
}

QWidget[class="AvarSessionListItem"][active="true"] {
    border-color: @@PRIMARY@@;
    background-color: @@BG_MUTED@@;
}

QScrollArea#AvarSessionMenuScroll {
    background: transparent;
    border: none;
}

QScrollArea#AvarSessionMenuScroll > QWidget > QWidget {
    background: transparent;
}

QLabel[class="AvarSessionListTitle"] {
    font-weight: 600;
    font-size: 14px;
    color: @@TEXT@@;
}

QLabel[class="AvarSessionListMeta"] {
    font-size: 12px;
    color: @@TEXT_MUTED@@;
}

QPushButton[class="AvarSessionAdd"] {
    width: 100%;
}

QLabel[class="AvarCardTitle"] {
    font-size: 16px;
    font-weight: 700;
    color: @@TEXT@@;
}

QWidget#AvarDownloadPanel {
    background-color: @@BG_ELEVATED@@;
    border-left: 1px solid @@BORDER@@;
}

QWidget#AvarResizeHandle[axis="horizontal"] {
    background: @@BG_MUTED@@;
    max-width: 6px;
}

QWidget#AvarResizeHandle[axis="vertical"] {
    background: @@BG_MUTED@@;
    max-height: 6px;
}
